# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. ".env" Git'e gönderilmez.

# Google AI Studio'dan alınan Gemini API anahtarı (https://aistudio.google.com/apikey).
# Boş bırakılırsa asistan, belgelerden doğrudan alıntı yapan anahtar kelime modunda çalışır.
GEMINI_API_KEY=

# İsteğe bağlı: sohbet modeli. Varsayılan, Google'ın her zaman güncel "lite" modele yönlendirdiği takma addır.
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# MySQL bağlantı bilgileri (docker-compose ve uygulama aynı değerleri kullanır)
DB_USERNAME=pos_user
DB_PASSWORD=pos_pass
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_PORT=3306
